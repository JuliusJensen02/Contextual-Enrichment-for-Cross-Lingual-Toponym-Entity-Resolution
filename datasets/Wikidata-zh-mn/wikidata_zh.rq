# Chinese pool: items with a Chinese name and a historical signal. Items in the class
# or CHGIS branches need no coordinates here, because most dynasties and Yuan circuits
# have none; scripts/build_wikidata_zh_mn.py derives their region. Branches that would
# otherwise return the whole world are limited to the region box directly.
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX geof: <http://www.opengis.net/def/function/geosparql/>
SELECT DISTINCT ?item ?signal WHERE {
  { ?item rdfs:label ?zh . FILTER(LANG(?zh) = "zh") }
  UNION { ?item rdfs:label ?zh . FILTER(LANG(?zh) = "zh-hans") }
  UNION { ?item rdfs:label ?zh . FILTER(LANG(?zh) = "zh-hant") }
  UNION { ?item rdfs:label ?zh . FILTER(LANG(?zh) = "lzh") }
  {
    VALUES ?signal { wd:Q3024240 wd:Q19953632 wd:Q1620908 wd:Q15661340 wd:Q839954 }
    ?item wdt:P31/wdt:P279* ?signal .      # historical country, former admin. entity,
  }                                        # historical region, ancient city, arch. site
  UNION { ?item wdt:P4711 ?chgis . BIND("chgis" AS ?signal) }
  UNION {
    ?item wdt:P576 ?end ; wdt:P625 ?c . BIND("dissolved" AS ?signal)
    FILTER(geof:latitude(?c) >= 13 && geof:latitude(?c) <= 59 && geof:longitude(?c) >= 68 && geof:longitude(?c) <= 140)
  }
  UNION {
    ?item wdt:P31/wdt:P279* wd:Q486972 ; wdt:P571 ?born ; wdt:P625 ?c . BIND("dated" AS ?signal)
    FILTER(YEAR(?born) < 1800)
    FILTER(geof:latitude(?c) >= 13 && geof:latitude(?c) <= 59 && geof:longitude(?c) >= 68 && geof:longitude(?c) <= 140)
  }
}
