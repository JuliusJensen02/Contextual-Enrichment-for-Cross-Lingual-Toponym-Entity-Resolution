# Mongolian pool: every item with a Mongolian name that has coordinates or a historical
# class. This is nearly all Mongolian place data in Wikidata, so region and toponym
# filtering happen in scripts/build_wikidata_zh_mn.py.
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT ?item ?signal WHERE {
  { ?item rdfs:label ?mn . FILTER(LANG(?mn) = "mn") }
  UNION { ?item skos:altLabel ?mn . FILTER(LANG(?mn) = "mn") }
  UNION { ?item wdt:P1705 ?mn . FILTER(LANG(?mn) = "mn") }
  { ?item wdt:P625 ?c . BIND("coord" AS ?signal) }
  UNION {
    VALUES ?signal { wd:Q3024240 wd:Q19953632 wd:Q1620908 wd:Q15661340 wd:Q839954 }
    ?item wdt:P31/wdt:P279* ?signal .
  }
}
